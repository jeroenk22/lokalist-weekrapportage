# Database
DB_SERVER=192.168.4.102
DB_DATABASE=MENDRIXDB01
DB_AUTH_METHOD=windows        # 'windows' = Windows Integrated Auth (productie); 'sql' = SQL-login
DB_DRIVER=ODBC Driver 18 for SQL Server
# DB_USER en DB_PASSWORD: alleen invullen bij DB_AUTH_METHOD=sql
DB_USER=
DB_PASSWORD=

# MendriX SOAP
MENDRIX_SOAP_URL=https://customlink.ophaaldienstmiedema.nl:5564/soap/ICustomLinkSoap
MENDRIX_SOAP_USER=
MENDRIX_SOAP_PASS=
# MENDRIX_CA_CERT: pad naar .pem voor zelfondertekend cert; 'false' om
# verificatie over te slaan (intern netwerk); leeg = systeemcertificaten
MENDRIX_CA_CERT=

# MendriX REST dossier-upload
MENDRIX_API_URL=https://customlink.ophaaldienstmiedema.nl:8443/api/
# MENDRIX_API_TOKEN: aanmaken via MendriX beheer → API-tokens
MENDRIX_API_TOKEN=
MENDRIX_DOSSIER_DOMAIN=orders

# E-mail — kies provider: 'smtp' of 'graph'
EMAIL_PROVIDER=smtp

# SMTP (EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_POORT=587
SMTP_GEBRUIKER=
SMTP_WACHTWOORD=
SMTP_GEBRUIK_TLS=true
AFZENDER_EMAIL=
EMAIL_ONTVANGERS=jeroenkrajenbrink@gmail.com,automatisering@ophaaldienstmiedema.nl
# EMAIL_CC en EMAIL_BCC: optioneel, kommagescheiden
EMAIL_CC=
EMAIL_BCC=

# Webdashboard: adressen die in de regenereer-modal wél zichtbaar zijn maar niet
# vooraf aangevinkt staan. Handig voor ontvangers die het wekelijkse rapport
# automatisch horen te krijgen, maar bij een handmatige hergeneratie meestal
# niet. De gebruiker kan ze in de modal alsnog aanvinken.
# Raakt de automatische zondagrun niet — die gebruikt EMAIL_ONTVANGERS/CC/BCC.
DASHBOARD_EMAIL_UITGEVINKT=

# Webdashboard: domeinen waarnaar het rapport verstuurd mag worden. In de modal
# kan iemand het Aan-adres aanpassen of adressen toevoegen; het rapport bevat
# klantgegevens, dus die adressen worden hiertegen gecontroleerd (server-side in
# web_runner.py, niet alleen in de browser).
# Kommagescheiden, met of zonder @. LEEG = geen begrenzing, dan mag elk adres.
# De adressen uit EMAIL_ONTVANGERS/CC/BCC en DASHBOARD_EMAIL_UITGEVINKT mogen
# altijd, ook als hun domein hier niet in staat.
DASHBOARD_EMAIL_DOMEINEN=

# Webdashboard: waar de Express-server op luistert. Let op — deze twee leest
# Node uit de omgeving, niet uit dit .env-bestand. Zet ze in de shell of in de
# Task Scheduler-taak; laat je ze weg, dan geldt de standaard.
DASHBOARD_POORT=3000
DASHBOARD_HOST=0.0.0.0

# Microsoft Graph (EMAIL_PROVIDER=graph)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=

# Admin-notificaties (lege run, fouten) — kommagescheiden, meerdere adressen mogelijk
ADMIN_EMAIL_ONTVANGERS=jeroenkrajenbrink@gmail.com

# Gedrag
WEEK_OFFSET=0                 # 0 = huidige ISO-week, 1 = vorige volledige week (standaard: 0, zie CLAUDE.md)
DRY_RUN=true                  # true = alleen lokaal PDF wegschrijven, geen order/mail
