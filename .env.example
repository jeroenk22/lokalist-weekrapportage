# Database
DB_SERVER=192.168.4.102
DB_DATABASE=MENDRIXDB01
DB_AUTH_METHOD=windows        # 'windows' = Windows Integrated Auth (productie); 'sql' = SQL-login
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_USER=                      # alleen bij DB_AUTH_METHOD=sql
DB_PASSWORD=                  # alleen bij DB_AUTH_METHOD=sql

# MendriX SOAP
MENDRIX_SOAP_URL=https://customlink.ophaaldienstmiedema.nl:5564/soap/ICustomLinkSoap
MENDRIX_SOAP_USER=
MENDRIX_SOAP_PASS=
MENDRIX_CA_CERT=              # pad naar .pem voor zelfondertekend cert; 'false' om verificatie over te slaan (intern netwerk); leeg = systeemcertificaten

# MendriX REST dossier-upload
MENDRIX_API_URL=https://customlink.ophaaldienstmiedema.nl:8443/api/
MENDRIX_API_TOKEN=            # MendriX API-token (aanmaken via MendriX beheer → API-tokens)
MENDRIX_DOSSIER_DOMAIN=orders

# E-mail — kies provider: 'smtp' of 'graph'
EMAIL_PROVIDER=smtp

# SMTP (EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_POORT=587
SMTP_GEBRUIKER=
SMTP_WACHTWOORD=
SMTP_GEBRUIK_TLS=true
AFZENDER_EMAIL=
EMAIL_ONTVANGERS=jeroenkrajenbrink@gmail.com,automatisering@ophaaldienstmiedema.nl
EMAIL_CC=                     # optioneel, kommagescheiden
EMAIL_BCC=                    # optioneel, kommagescheiden

# Microsoft Graph (EMAIL_PROVIDER=graph)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=

# Admin-notificaties (lege run, fouten) — kommagescheiden, meerdere adressen mogelijk
ADMIN_EMAIL_ONTVANGERS=jeroenkrajenbrink@gmail.com

# Gedrag
WEEK_OFFSET=0                 # 0 = huidige ISO-week, 1 = vorige volledige week
DRY_RUN=true                  # true = alleen lokaal PDF wegschrijven, geen order/mail
